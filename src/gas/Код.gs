// === ПОЛУЧИТЬ ССЫЛКИ НА ТЕСТЫ 31-35 (МЕНЮ) ===
function getTestsLinks31To35() {
  const links = [];
  const testIds = [31, 32, 33, 34, 35];
  const testNames = [
    'Итоговый повтор 3.1',
    'Итоговый повтор 3.2',
    'Итоговый повтор 3.3',
    'Итоговый повтор 3.4',
    'Итоговый повтор 3.5'
  ];

  for (let i = 0; i < testIds.length; i++) {
    const link = getTestLinkGeneric(testIds[i]);
    if (link) {
      links.push(testIds[i] + '. ' + testNames[i] + ':\n' + link);
    }
  }

  if (links.length > 0) {
    SpreadsheetApp.getUi().alert(
      '[OK] Ссылки на тесты 3.1-3.5 добавлены в таблицу!\n\n' + links.join('\n\n')
    );
  } else {
    SpreadsheetApp.getUi().alert('[ERROR] Тесты 31-35 не найдены. Сначала добавь тесты!');
  }
}

