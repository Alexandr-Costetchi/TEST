// === ФУНКЦИЯ 2: ДОБАВИТЬ ВСЕ 75 ВОПРОСОВ ТЕСТОВ 31-35 ===
function addTests31To35Questions(ss) {
  const questionsSheet = ss.getSheetByName(SHEET_QUESTIONS);

  if (!questionsSheet) throw new Error('Лист "Вопросы" не найден');

  // Проверка - существуют ли уже вопросы для тестов 31-35
  const lastRow = questionsSheet.getLastRow();
  if (lastRow > 1) {
    const existingData = questionsSheet.getRange(2, 1, Math.max(0, lastRow - 1), 1).getValues();
    let existingCount = 0;
    for (const row of existingData) {
      if (row[0] >= 31 && row[0] <= 35) existingCount++;
    }
    if (existingCount > 0) {
      Logger.log('[WARNING] Tests 31-35 уже добавлены (' + existingCount + ' вопросов). Пропускаю добавление.');
      throw new Error('Вопросы тестов 31-35 уже существуют в таблице');
    }
  }

  // Получить JSON с вопросами из DriveAPI или встроенные данные
  // Альтернативно - использовать readTestsDataFromFile() если файл скопирован
  const questions = getQuestions31To35();

  // Добавить все вопросы
  const insertRow = lastRow + 1;
  questionsSheet.getRange(insertRow, 1, questions.length, 10).setValues(questions);

  Logger.log('[OK] ' + questions.length + ' вопросов добавлено в "Вопросы" (с строки ' + insertRow + ')');
}

