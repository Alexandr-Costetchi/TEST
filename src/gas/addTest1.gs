// === ГЛАВНАЯ ФУНКЦИЯ - ДОБАВИТЬ ВСЕ ДАННЫЕ ТЕСТА #1 ===
function addTest1Data() {
  try {
    const ss = SpreadsheetApp.openById(SPREADSHEET_ID);

    // 1. Добавить тест в "Архив"
    addTestToArchive(ss);

    // 2. Добавить все 26 вопросов в "Вопросы"
    addAllQuestions(ss);

    SpreadsheetApp.getUi().alert('✅ Тест #1 успешно добавлен!\n\n• Архив: 1 строка\n• Вопросы: 26 вопросов');
    Logger.log('✅ Тест #1 полностью добавлен');

  } catch (error) {
    SpreadsheetApp.getUi().alert('❌ Ошибка: ' + error.message);
    Logger.log('❌ Ошибка при добавлении теста #1: ' + error.message);
  }
}

// === ФУНКЦИЯ 1: ДОБАВИТЬ ТЕСТ В "АРХИВ" ===
function addTestToArchive(ss) {
  const archiveSheet = ss.getSheetByName(SHEET_ARCHIVE);

  if (!archiveSheet) throw new Error('Лист "Архив" не найден');

  // Данные теста
  const testRow = [
    1,  // №/ID
    '3 Социология',  // Блок
    '3.4/3.6 Статус, роль, стратификация, социализация',  // Тема
    'Итоговый',  // Назначение
    ''  // URL (будет добавлено после развертывания)
  ];

  // Добавить в конец
  const lastRow = archiveSheet.getLastRow() + 1;
  archiveSheet.getRange(lastRow, 1, 1, 5).setValues([testRow]);

  Logger.log('✅ Тест #1 добавлен в "Архив" (строка ' + lastRow + ')');
}

